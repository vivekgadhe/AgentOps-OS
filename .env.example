# Copy to .env (make env does this). Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=console

# Used by docker-compose.yml to create the database
POSTGRES_USER=agentops
POSTGRES_PASSWORD=agentops
POSTGRES_DB=agentops
POSTGRES_PORT=5433

# Used by the application. Must match the values above.
# The "+psycopg" part selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5433/agentops


# Used ONLY by integration tests. The database name must end in "_test"
# (tests refuse to run otherwise). agentops_test is created by
# docker/postgres/init/01-create-test-db.sql on first volume creation.
TEST_DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5433/agentops_test

# Only the dev default is accepted when APP_ENV=dev.
# For any other environment use a random value of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me